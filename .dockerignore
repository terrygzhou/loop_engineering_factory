# Keep the Docker build context lean — exclude generated projects, caches, and
# anything that shouldn't be baked into the image.
#
# NOTE: Do NOT ignore *.md — skills are SKILL.md files loaded by tools/loader.py.
# Do NOT ignore tests/ — some tests are needed for container self-check.

# Python virtual envs
.venv/
venv/

# Generated project output
output/
build/

# Logs & local storage
log/
storage/

# Python bytecode & caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage
.coverage
coverage.xml
htmlcov/

# VCS
.git/
.gitignore

# Docs & reports (not needed in the image)
docs/
reports/
.codegraph/
